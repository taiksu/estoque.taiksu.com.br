<img id="banner-01" src="/images/banners/banner-01.png" class="hidden md:block cursor-default w-full rounded-xl border border-gray-200">

<div id="fornecedores-container" class="mt-8 w-full flex flex-row justify-between gap-4 md:gap-8 overflow-x-scroll my-3 noscrollbar">
<!-- Fornecedores serão populados aqui com JS-->
</div>

<div id="container-insumos" class="flex flex-col gap-3">
    <!-- O conteúdo do container será adicionado dinamicamente -->
</div>

<div id="modal-adicionar-carrinho" class="hidden bg-black/20 backdrop-blur-sm fixed top-0 left-0 w-full h-full flex flex-col gap-4 items-center px-8 justify-center">
    <div id="modal-box" class="scale-0 transition-all duration-400 bg-white rounded-xl p-8 w-full max-w-lg border border-gray-200">
        <div id="modal-content" class="flex flex-col gap-4">
            <!-- O conteúdo do modal será adicionado dinamicamente -->
        </div>
    </div>
    <div id="fechar-popup" class="cursor-pointer bg-white text-gray-500 text-sm px-3 py-1 rounded-full opacity-70 hover:opacity-80 transition-all duration-600 flex flex-row gap-1 items-center">
        <img class="h-5 grayscale" src="/images/icones/falha.png">
        Fechar janela
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', async function() {
        const fornecedoresContainer = document.getElementById('fornecedores-container');

        const response = await fetch('https://insumos.taiksu.com.br/fornecedores')
        const fornecedores = await response.json();

        fornecedores.forEach(fornecedor => {
            // Ignora fornecedor local ID 9
            if (fornecedor.id == 9 ) return;

            const divFornecedor = document.createElement('a');
            divFornecedor.className = 'flex-shrink-0 flex flex-col items-center gap-2';
            divFornecedor.href = `/comprar/fornecedor/${fornecedor.id}`;
            divFornecedor.innerHTML = `
                <img src="https://insumos.taiksu.com.br/images/fornecedores/${fornecedor.logo_path}" class="cursor-pointer hover:shadow-xl transition-all duration-300 md:h-28 h-16 w-16 md:w-28 object-contain rounded-full bg-white border border-gray-200">
                <h2 class="text-xs text-gray-600 hidden md:block">${fornecedor.nome}</h2>
            `;
            fornecedoresContainer.appendChild(divFornecedor);
        });
    });
</script>



<script>
    document.addEventListener('DOMContentLoaded', async function() {

        //// Elementos do DOM
        const container = document.getElementById('container-insumos');
        const modal = document.getElementById('modal-adicionar-carrinho');
        const modalContent = document.getElementById('modal-content');
        const closemodal = document.getElementById('fechar-popup');
        const modalBox = document.getElementById('modal-box');
        const unidadeId = <%= unidade_id %>;

        //// Busca os insumos na API
        const response = await fetch('https://insumos.taiksu.com.br/insumos?visibilidade=loja')
        const categorias = await response.json();

        //// Função para mostrar o toast
        function mostrarToast() {
            toast.classList.remove('hidden');
            toast.classList.add('flex');
            setTimeout(() => {
                toast.classList.add('hidden');
                toast.classList.remove('flex');
            }, 800);
        }


        //// Função que renderiza categoria
        function popularLista(categoriaRenderizar) {
            Object.keys(categorias).forEach(categoria => {
                if(categoria !== categoriaRenderizar) return;
                const divCategoria = document.createElement('div');
                divCategoria.className = 'flex flex-col gap-1 my-4 categoria-insumos';
                divCategoria.innerHTML = `
                <h2 id="${categoria}" class="text-sm text-gray-500">${categoria}</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-4">
                    ${categorias[categoria].map(insumo => `
                            <div data-insumo-id="${insumo.id}" class="group cursor-pointer insumo-card flex flex-row items-center justify-between bg-white border border-gray-200 rounded-xl p-3 hover:shadow-sm transition-all duration-300">

                                <div class="w-full flex flex-col items-center justify-between">
                                    <div class="relative w-full flex items-center justify-center rounded-sm">
                                        <img data-insumo-id="${insumo.id}" class="hidden md:flex favoritar absolute top-1 right-1 cursor-pointer rounded-full p-1 border border-gray-100 transition-all duration-500 opacity-80 hover:bg-pink-100 bg-gray-50 h-7 w-7" src="/images/icones/favoritos.png">
                                        <img class="insumo-foto object-contain h-32 pt-2 w-full" src="https://insumos.taiksu.com.br/${insumo.foto_url}">
                                    </div>
                                    
                                    <div class="w-full flex flex-col gap-0">
                                        <h3 class="mt-4 w-full insumo-nome text-sm text-gray-600 group-hover:text-green-700 font-medium">
                                            ${insumo.nome.length > 24 ? insumo.nome.substring(0, 26) + '...' : insumo.nome} 
                                        </h3>
                                        <h4 class="hidden md:block text-xs text-gray-500">
                                            ${insumo.marca.nome}
                                        </h4>
                                    </div>
                                    <div class="flex flex-col items-start w-full mt-4 ml-1">
                                        <p class="text-xs text-gray-500">A partir de</p>
                                        <p class="insumo-preco text-lg text-green-700 font-semibold">R$ 0,00</p>
                                    </div>
                                    <div id="comprar-btn-${insumo.id}" class="hidden md:block mt-4 h-full w-full text-green-600 bg-green-100 hover:bg-green-200 rounded-full text-center py-1 transition-all duration-300">Comprar</div>
                                </div>


                            </div>
                    `).join('')}
                </div>
            `;
            container.appendChild(divCategoria);
        });
        }

        // 2 banners grandes
        const divBanner = document.createElement('div');
        divBanner.id = 'banners-1';
        divBanner.className = 'w-full grid grid-cols-1 md:grid-cols-2 gap-4';
        divBanner.innerHTML = `
            <div class="insumo-card banner cursor-pointer group overflow-hidden border border-gray-200 rounded-xl" data-insumo-id="140">
                <img src="/images/banners/creamcheese.png" class="w-full object-cover group-hover:scale-103 transition-scale duration-600">
                <img class="insumo-foto hidden" src="https://insumos.taiksu.com.br/images/insumos/insumo-1772562423938-997957681.webp">
                <p class="insumo-nome hidden">Cream Cheese Polenghi 1Kg</p>
                <p class="insumo-preco hidden">R$ 0,00</p>
            </div>

            <div class="insumo-card banner cursor-pointer group overflow-hidden border border-gray-200 rounded-xl" data-insumo-id="133">
                <img src="/images/banners/kewpie.png" class="w-full object-cover group-hover:scale-103 transition-scale duration-600">
                <img class="insumo-foto hidden" src="https://insumos.taiksu.com.br/images/insumos/insumo-1772561037679-249216041.webp">
                <p class="insumo-nome hidden">Maionese Kewpie 450g</p>
                <p class="insumo-preco hidden">R$ 0,00</p>
            </div>
        `;

        // Banner de benefícios 
        const beneficios = document.createElement('div');
        beneficios.id = 'banner-beneficios';
        beneficios.className = 'w-full';
        beneficios.innerHTML = `
            <img src="/images/banners/beneficio.png" class="w-full">
        `;

        // Monta o catálogo da loja e banners
        popularLista('Oriental');
        container.appendChild(divBanner);
        popularLista('Proteínas');
        container.appendChild(beneficios);
        popularLista('Embalagens');
        popularLista('Mercearia');
        popularLista('Condimentos');
        popularLista('Molhos');
        popularLista('Óleos');
        popularLista('Utensílios');
        popularLista('Frutos do Mar');

        // Busca disponibilidade para alterar os cards
        const responseDisponibilidade = await fetch('https://catalogo.taiksu.com.br/api/disponibilidade');
        const disponibilidade = await responseDisponibilidade.json();
        console.log('Lista de disponibilidade:', disponibilidade);

        // Altera os cards com base na disponibilidade
        disponibilidade.forEach(item => {
            const card = document.querySelector(`.insumo-card[data-insumo-id="${item.insumo_id}"]:not(.banner)`);
    
            if (card) { // Seleciona o preço dentro do card do insumo
                const cardId = card.getAttribute('data-insumo-id');
                card.querySelector('.insumo-preco').textContent = Number(item.preco).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            }
        });

        // percorre todos os cards e desabilita os que não tem preço
        const cards = document.querySelectorAll('.insumo-card:not(.banner)');
        cards.forEach(card => {
            if (!card.querySelector('.insumo-preco').textContent || card.querySelector('.insumo-preco').textContent === 'R$ 0,00') {
                card.classList.add('opacity-60');
                card.classList.add('pointer-events-none');
                card.classList.add('cursor-not-allowed');
                const button = card.querySelector(`#comprar-btn-${card.getAttribute('data-insumo-id')}`);
                button.textContent = 'Indisponível';
                button.classList.remove('text-green-600');
                button.classList.remove('bg-green-100');
                button.classList.add('text-gray-600');
                button.classList.add('bg-gray-100');
            }
        });

        // Busca favoritos
        const responseFavoritos = await fetch(`https://carrinho.taiksu.com.br/api/favoritos/${unidadeId}`);
        const favoritos = await responseFavoritos.json();
        console.log('Lista de favoritos:', favoritos);

        // Percorre todos os cards e adiciona o ícone de favorito se o insumo estiver na lista de favoritos
        favoritos.forEach(favorito => {
            const card = document.querySelector(`.insumo-card[data-insumo-id="${favorito.insumo_id}"]:not(.banner)`);
            if (card) {
                const button = card.querySelector('.favoritar');
                button.src = '/images/icones/favorito.png';
                button.classList.remove('bg-gray-50');
                button.classList.add('bg-pink-100');
            }
        });

        
        // Função para tocar som
        const favoritarButtons = document.getElementsByClassName('favoritar');
        const som = new Audio('/sound/heart.mp3');
        function tocarSom() {
            som.play();
        }
        
        // Seleciona todos botos com ID favoritar
        for (let i = 0; i < favoritarButtons.length; i++) {
            favoritarButtons[i].addEventListener('click', async function(e) {
                e.stopPropagation();

                const insumoId = this.getAttribute('data-insumo-id');
                const response = await fetch('https://carrinho.taiksu.com.br/api/favorito', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        unidade_id: unidadeId,
                        insumo_id: insumoId
                    })
                });
                const data = await response.json();
                if(data.success && data.status === 'favoritado') {
                    tocarSom();
                    this.src = '/images/icones/favorito.png';
                    this.classList.add('scale-150');
                    setTimeout(() => {
                        this.classList.remove('scale-150');
                    }, 400);
                    this.classList.remove('bg-gray-50');
                    this.classList.add('bg-pink-100');
                } else if(data.success && data.status === 'removido') {
                    tocarSom();
                    this.classList.add('scale-150');
                    setTimeout(() => {
                        this.classList.remove('scale-150');
                    }, 400);
                    this.src = '/images/icones/favoritos.png';
                    this.classList.remove('bg-pink-100');
                    this.classList.add('bg-gray-50');
                } else {
                    alert('Falha ao favoritar item');
                }
            });
        };



        //// Interações para abrir o pop-up ao clicar no card do insumo
        const insumos = document.querySelectorAll('.insumo-card');

        insumos.forEach(insumo => {
            insumo.addEventListener('click', async function() {
                const insumoId = this.getAttribute('data-insumo-id');
                const insumoNome = this.querySelector('.insumo-nome').textContent;
                const insumoFoto = this.querySelector('.insumo-foto').src;

                // Abre o modal
                modal.classList.remove('hidden');
                setTimeout(() => {
                    modalBox.classList.remove('scale-0');
                    modalBox.classList.add('scale-100');
                    closemodal.classList.remove('hidden');
                }, 80);
                modalContent.innerHTML = `
                    <div class="flex flex-col gap-4">

                        <div class="flex flex-row items-center gap-2 mb-4">
                            <img src="${insumoFoto}" class="md:h-16 md:w-16 h-10 w-10 rounded-md bg-white border border-gray-100">
                            <div class="flex flex-col gap-0 mt-1">
                                <h2 class="text-xs text-gray-500">Adicionar ao Carrinho</h2>
                                <h2 class="text-lg text-gray-700 font-semibold">${insumoNome}</h2>
                            </div>
                        </div>

                        <div id="modal-content-precos" class="flex flex-col gap-2 px-4 rounded-md border border-gray-100">
                            <!-- O conteúdo do modal será adicionado pela próxima função kkk -->
                        </div>
                        
                        <div id="modal-content-quantidade" class="w-full flex flex-col items-center gap-2 mt-1">
                            <div class="w-full flex flex-row items-center gap-2">
                                <div class="w-full flex flex-col gap-0">
                                    <h2 class="text-xs text-gray-500">Fornecedor</h2>
                                    <select id="fornecedor" class="w-full p-2 border border-gray-200 rounded-md appearance-none">
                                        <option disabled selected value="">Selecione um fornecedor</option>
                                    </select>
                                </div>
                                <div class="w-24flex flex-col gap-0">
                                    <h2 class="text-xs text-gray-500">Quantidade</h2>
                                    <input type="number" id="quantidade" class="w-full p-2 border border-gray-200 rounded-md" placeholder="Qtd.">
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-row items-center justify-between">
                            <h3 class="text-md text-gray-600">Total:</h3>
                            <h2 id="preco-total" class="text-md text-green-700 font-semibold">R$ 0,00</h2>
                        </div>
                        <button data-insumo-id="${insumoId}" id="adicionar-carrinho" class="mt-4 cursor-pointer w-full p-2 bg-green-600 hover:bg-green-700 transition-all duration-300 text-white rounded-full">Adicionar ao carrinho</button>

                    </div>
                `;

                // Verifica se o modal está aberto e permite confirmar com enter
                if (!modal.classList.contains('hidden')) {
                    document.addEventListener('keydown', function(event) {
                        if (event.key === 'Enter') {
                            adicionarCarrinhoButton.click();
                        }
                    });
                }

                // Busca valores na API catálogo
                const response = await fetch(`https://catalogo.taiksu.com.br/api/insumo/${insumoId}`).then(res => res.json());
                const precos = response.precos;
                const modalContentPrecos = document.getElementById('modal-content-precos');
                const modalContentQuantidade = document.getElementById('modal-content-quantidade'); 
                const adicionarCarrinhoButton = document.getElementById('adicionar-carrinho');  
                const itensCarrinho = document.getElementById('itens-carrinho');      

                if(precos.length == 0) {
                    modalContentPrecos.innerHTML = `
                        <div class="flex flex-col gap-4 items-center justify-center p-8">
                            <img src="/images/icones/search.png" class="h-12 w-12">
                            <h2 class="text-sm text-gray-600 text-center font-medium">Nenhum fornecedor encontrado<br> para este insumo</h2>
                        </div>
                    `;
                    console.log('Nenhum fornecedor encontrado para este insumo');
                    modalContentQuantidade.innerHTML = '';
                    adicionarCarrinhoButton.classList.add('hidden');
                }

                // Popula os preços no modal
                precos.forEach(preco => {
                    const divPreco = document.createElement('div');
                    divPreco.className = 'flex flex-row items-center justify-between border-b border-gray-100 last:border-b-0 py-2';
                    divPreco.innerHTML = `
                        <div class="flex flex-row items-center gap-2">
                            <img src="${preco.fornecedor_logo}" class="h-8 w-8 rounded-full bg-white border border-gray-100">
                            <h2 class="text-gray-600 font-medium">${preco.nome_fornecedor}</h2>
                        </div>
                        <h2 class="text-green-800 font-semibold">R$ ${preco.preco.replace('.', ',')} <span class="text-sm text-gray-500">/${response.precos[0].unidade_medida}</span></h2>
                        <p data-fornecedor="${preco.fornecedor_id}" class="hidden preco-fornecedor">${preco.preco}</p>
                    `;
                    modalContentPrecos.appendChild(divPreco);
                });

                // Remove ponto do input se a unidade de medida for unidade
                let unidadeMedida = response.precos[0].unidade_medida;   
                if(unidadeMedida != 'kg') {
                    document.getElementById('quantidade').addEventListener('input', function() {
                        this.value = this.value.replace('.', '');

                        // Impede número negativo
                        if(this.value < 0) {
                            this.value = 0;
                        }
                    });
                }

                // Popula o select de fornecedores
                const fornecedorSelect = document.getElementById('fornecedor');
                precos.forEach(preco => {
                    const option = document.createElement('option');
                    option.value = preco.fornecedor_id;
                    option.text = preco.nome_fornecedor;
                    fornecedorSelect.appendChild(option);
                });

                // Calcula o preço total
                document.getElementById('quantidade').addEventListener('input', function() {
                    const quantidade = this.value;
                    const fornecedorselecionado = document.getElementById('fornecedor').value;
                    console.log('fornecedor selecionado: ' + fornecedorselecionado);
                    const precofornecedor = document.querySelector(`.preco-fornecedor[data-fornecedor="${fornecedorselecionado}"]`).textContent;
                    console.log('preço do fornecedor: ' + precofornecedor);
                    const precoTotal = quantidade * precofornecedor;
                    document.getElementById('preco-total').textContent = precoTotal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                });

                // Botão adicionar ao carrinho
                adicionarCarrinhoButton.addEventListener('click', async function() {
                    const quantidade = document.getElementById('quantidade').value;
                    const fornecedorselecionado = document.getElementById('fornecedor').value;
                    const insumoId = this.getAttribute('data-insumo-id');
                    const unidadeMedida = this.getAttribute('data-unidade-medida');
                    const quantidadeCarrinho = document.getElementById('quantidade-carrinho')
                    const iconeCarrinho = document.getElementById('icone-carrinho')
                    const responsavelId = <%= user_id %>;
                    const unidadeId = <%= unidade_id %>;

                    // Obriga seleciona fornecedor
                    if(fornecedorselecionado === '') {
                        alert('Selecione um fornecedor');
                        return;
                    }

                    // Obriga quantidade maior que 0
                    if(quantidade <= 0) {
                        alert('Quantidade inválida');
                        return;
                    }

                    const response = await fetch('https://carrinho.taiksu.com.br/api/add', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            insumo_id: insumoId,
                            quantidade: quantidade,
                            fornecedor_id: fornecedorselecionado,
                            unidade_id: unidadeId,
                            responsavel_id: responsavelId
                        })
                    });

                    const data = await response.json();
                    console.log(data);

                    // Atualiza o carrinho e fecha o modal
                    quantidadeCarrinho.textContent = data.quantidade_itens + ' itens';
                    console.log('quanitade recebida da API: ', data.quantidade_itens, 'valor carrinho atualizado: ', quantidadeCarrinho.textContent);
                    iconeCarrinho.src = '/images/icones/carrinho-cheio.png';
                    modalContent.innerHTML = `
                        <div class="flex flex-col items-center gap-2 py-24">
                            <img src="https://estoque.taiksu.com.br/images/icones/certo.png" class="h-12 w-12">
                            <h2 class="font-semibold text-lg text-green-700">${insumoNome}</h2>
                            <p class="text-gray-500">adicionado ao carrinho!</p>
                        </div>
                    `;
                    setTimeout(() => {
                        closemodal.classList.add('hidden');
                        modalBox.classList.remove('scale-100');
                        modalBox.classList.add('scale-0');
                        setTimeout(() => {
                            modal.classList.add('hidden');
                            modalContent.innerHTML = '';
                            document.getElementById('quantidade').value = '';
                            document.getElementById('fornecedor').value = '';
                        }, 300);
                    }, 900);

                    // Adiciona item ao popup do carrinho
                    const itemCarrinho = document.createElement('div');
                    itemCarrinho.innerHTML = `
                        <div class="flex flex-row gap-2 px-2 items-center justify-between border-b border-gray-100 rounded-lg last:border-0 py-3 hover:bg-gray-50">
                            <div class="flex flex-row gap-2 items-center">
                                <img src="${insumoFoto}" class="h-10 w-10 rounded-lg">
                                <div class="flex flex-col items-start">
                                    <span class="text-gray-600 font-medium text-sm">${insumoNome}</span>
                                    <span class="text-gray-500 text-xs">${quantidade}</span>
                                </div>
                            </div>
                            <img id="delete-${insumoId}" class="h-8 opacity-90 hover:opacity-100 transition-colors duration-200 p-1 rounded-full bg-red-50 hover:bg-red-100 cursor-pointer" src="https://tarefas.taiksu.com.br/images/icones/delete.png">
                        </div>
                    `;
                    itensCarrinho.appendChild(itemCarrinho);
                    
                    document.getElementById('void-cart').classList.add('hidden');

                    // Se der erro, mostra alerta e não faz mais nada
                    if(!response.ok) {
                        alert('Falha ao adicionar item ao carrinho, tente novamente.');
                        throw new Error('Falha ao adicionar item ao carrinho');
                    }
                });


            });
        });

        // Fecha modal apertando ESC
        document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            modalBox.classList.remove('scale-100');
            modalBox.classList.add('scale-0');
            modal.classList.add('hidden');
            modalContent.innerHTML = '';
        }});

        // Fecha modal ao clica no botao
        closemodal.addEventListener('click', function(e) {
            if (e.target === closemodal) {
                modalBox.classList.remove('scale-100');
                modalBox.classList.add('scale-0');
                setTimeout(() => {
                    modal.classList.add('hidden');
                    modalContent.innerHTML = '';
                }, 100);
            }
        });

        //// Fecha o pop-up ao clicar fora
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                modalBox.classList.remove('scale-100');
                modalBox.classList.add('scale-0');
                setTimeout(() => {
                    modal.classList.add('hidden');
                    modalContent.innerHTML = '';
                }, 100);
            }
        });
    });
</script>