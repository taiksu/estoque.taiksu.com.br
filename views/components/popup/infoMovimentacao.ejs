
<% 
let movimento;
let cor_movimentacao;
if(tipo == 'entrada') {
    movimento = 'Entrada';
    cor_movimentacao = 'text-green-600';
} else {
    movimento = 'Saída';
    cor_movimentacao = 'text-red-600';
}
%>

<div id="detalhes-movimentacao" class="hidden bg-black/20 backdrop-blur-sm z-20 fixed top-0 left-0 w-full h-full flex flex-col gap-4 items-center px-8 justify-center">
    <div class="max-w-2xl mt-16 w-full bg-white rounded-xl p-8 border border-gray-200">
        <div class="flex flex-row items-center justify-between mb-12">
        <h2 class="text-gray-700 font-medium text-xl">Lotes desta <span id="tipo-movimentacao" class="font-semibold <%=cor_movimentacao%>"><%=movimento%></span></h2>
        <a href="" id="editar-data-movimentacao" class="shadow-lg cursor-pointer flex flex-row items-center gap-2 rounded-full border border-gray-300 hover:bg-gray-100 text-gray-800 px-4 py-1 transition-color duration-300">
            <img class="h-5 w-5" src="https://financeiro.taiksu.com.br/images/icones/border_color.png">
            <h4 class="text-gray-800">Editar data</h4>
        </a>
        </div>

        <div id="lotes-movimentacao" class="flex flex-col gap-3 mt-4 max-h-[420px] overflow-y-scroll">
            <!--Os lotes serão populados aqui-->
        </div>
        <div class="mt-4 text-xs text-gray-400 text-right">ID do grupo: <span id="id-grupo"></span></div>
    </div>
    <div id="fechar-popup" class="cursor-pointer bg-white text-gray-500 text-sm px-3 py-1 rounded-full opacity-70 hover:opacity-80 transition-all duration-600 flex flex-row gap-1 items-center">
        <img class="h-5 grayscale" src="/images/icones/falha.png">
        Fechar janela
    </div>
</div>

<script>
const modal = document.getElementById('detalhes-movimentacao');
const lotes = document.getElementById('lotes-movimentacao');
const close = document.getElementById('fechar-popup');


close.addEventListener('click', (event) => {
    if (event.target === close) {
        fecharModal();
    }
});

// fechar clicando no background
modal.addEventListener('click', (event) => {
    if (event.target === modal) {
        fecharModal();
    }
});


// Fecha modal apertando ESC
document.addEventListener('keydown', (e) => {
if (e.key === 'Escape') {
    fecharModal();
}});

function fecharModal() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
    lotes.innerHTML = '';
}
</script>