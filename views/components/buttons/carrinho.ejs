<div class="relative group inline-block mt-1">
    
    <a id="carrinho-container" href="/comprar/carrinho" class="mb-2 px-4 py-1 hover:bg-green-50 rounded-full bg-white border border-gray-200 flex flex-row gap-2 items-center transition-colors duration-300">
        <img id="icone-carrinho" class="h-5 w-5" src="/images/icones/comprar.png" alt="">
        <span id="quantidade-carrinho" class="hidden md:block text-gray-500 text-sm">0 itens</span>
    </a>

    <div id="wrapper-itens" class="scale-0 group-hover:scale-100 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 origin-top-right bg-white border border-gray-200 rounded-lg p-4 absolute top-full right-0 w-90">
        <div id="itens-carrinho" class="max-h-[320px] overflow-y-scroll">
            <!-- itens -->
        </div>
        <a href="/comprar/carrinho" class="mt-4 p-1.5 hover:bg-green-600 rounded-full bg-green-500 flex flex-row gap-2 items-center transition-colors duration-300">
            <span class="w-full text-center font-semibold text-white text-sm">Ver carrinho</span>
        </a>
    </div>

</div>

<!--Script pra verificar carrinho no microserviço-->
<script>
    document.addEventListener('DOMContentLoaded', async function() {
        const unidade_id = <%= unidade_id %>;
        const carrinhoContainer = document.getElementById('carrinho-container');
        const iconeCarrinho = document.getElementById('icone-carrinho');
        const quantidadeCarrinho = document.getElementById('quantidade-carrinho');
        const itensCarrinho = document.getElementById('itens-carrinho');



        const response = await fetch(`https://carrinho.taiksu.com.br/api/carrinho/${unidade_id}`);
        const data = await response.json();
        console.log(data);

        if (response.ok) {
            if(data.quantidade_itens > 0) {
                quantidadeCarrinho.textContent = data.quantidade_itens + ' itens';
                iconeCarrinho.src = '/images/icones/carrinho-cheio.png';

                data.lista_itens.forEach(item => {

                let quantidadeFormatada = '';
                if(item.unidade_medida == 'uni') {
                    quantidadeFormatada = Number(item.quantidade).toFixed(0) + ' ' + item.unidade_medida;
                } else {
                    quantidadeFormatada = Number(item.quantidade).toFixed(2) + ' ' + item.unidade_medida;
                }

                itensCarrinho.innerHTML += `
                        <div class="transition-all duration-300 flex flex-row px-2 items-center justify-between border-b border-gray-100 rounded-lg last:border-0 py-3">
                            <div class="flex flex-row gap-2 items-center">
                                <img src="${item.foto_url}" class="h-10 w-10 rounded-lg">
                                <div class="flex flex-col items-start max-w-50">
                                    <span class="text-gray-600 font-medium text-sm">${item.nome}</span>
                                    <span class="text-gray-500 text-xs">${quantidadeFormatada}</span>
                                </div>
                            </div>
                            <img id="delete-${item.id}" class="h-8 opacity-90 hover:opacity-100 transition-colors duration-200 p-1 rounded-full bg-red-50 hover:bg-red-100 cursor-pointer" src="https://tarefas.taiksu.com.br/images/icones/delete.png">
                        </div>
                    `;
                });
            } else {
                quantidadeCarrinho.textContent = '0 itens';
                itensCarrinho.innerHTML = `
                    <div id="void-cart" class="flex flex-col items-center justify-center h-full py-16">
                        <img src="/images/icones/vazio.png" class="h-10 w-10">
                        <span class="text-gray-500 text-sm">Carrinho vazio</span>
                    </div>
                `;
            }
        } else {
            alert('Não foi possível carregar o carrinho, recarregue a página');
        }

        document.querySelectorAll('[id^="delete-"]').forEach(button => {
            button.addEventListener('click', async function() {
                const item_id = this.id.replace('delete-', '');
                const response = await fetch(`https://carrinho.taiksu.com.br/api/delete-item`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        item_id: item_id
                    })
                });
                const data = await response.json();
                console.log('removendo item_id: ', item_id);
                console.log(data);
                if (response.ok) {
                    // Desliza o card pro lado e depois remove do DOM
                    this.parentElement.classList.add('translate-x-full');
                    setTimeout(() => {
                        this.parentElement.remove();
                    }, 300);
                    quantidadeCarrinho.textContent = data.quantidade_itens + ' itens';
                    if(data.quantidade_itens === 0) {
                        quantidadeCarrinho.textContent = '0 itens';
                        itensCarrinho.innerHTML = `
                            <div id="void-cart" class="flex flex-col items-center justify-center h-full py-16">
                                <img src="/images/icones/vazio.png" class="h-10 w-10">
                                <span class="text-gray-500 text-sm">Carrinho vazio</span>
                            </div>
                        `;
                    }
                } else {
                    alert('Não foi possível remover o item, recarregue a página');
                }
            });
        });
    });
</script>