<%- include('../components/toast', { sucess: true, texto: 'Balanço de estoque finalizado com sucesso', id: 'sucesso-toast' }); %>
<%- include('../components/toast', { sucess: false, texto: 'Falha ao finalizar o balanço de estoque', id: 'falha-toast' }); %>
<%- include('../components/popup/editarEntrada') %>
<%- include('../components/popup/pinModal') %>

<div id="container-balanco">
    <div class="flex flex-row items-center justify-between">
        <%- include('../components/breadcrumb', { link: '/balanco', paginaAnterior: 'Balanco'}) %>
    </div>

    <div id="informacoes-balanco" class="flex flex-col gap-1 items-start p-6 bg-white rounded-xl border border-gray-200 my-6">
        <h2 class="text-md font-semibold text-gray-600 mb-1">Informações finais</h2>
        <p class="text-sm text-gray-500">1. Os itens com quantidade <b class="text-red-800">menor que a nova quantidade</b> serão atualizados.</p>
        <p class="text-sm text-gray-500">2. Itens com quantidade <b class="text-green-800">maior que a nova quantidade</b> serão debitados.</p>
        <p class="text-sm text-gray-500">3. O balanço gera movimentações de saída que afetam o <b class="text-green-700">CMV</b>.</p>
    </div>

    <%- include('../partials/containerListaBalanco') %>

    <button id="finalizar-balanco" class="hidden w-full mt-4 cursor-pointer bg-green-600 text-white py-3 rounded-full hover:bg-green-700 transition-colors duration-300">
        Confirmar balanço
    </button>
</div>

<script>
    const finalizarBalanco = document.getElementById('finalizar-balanco');
    const sucessoToast = document.getElementById('sucesso-toast');
    const containerBalanco = document.getElementById('container-balanco');
    const falhaToast = document.getElementById('falha-toast');
    const unidade_id = <%= unidade_id %>;
    const abrirMenuIcon = document.getElementById('abrir-menu');
    const pinModal = document.getElementById('pin-modal');
    const confirmarPin = document.getElementById('confirmar-pin');
    const userPin = '<%= userPin %>';
    const pinInput = document.getElementById('pin-input');

    function trocaBotao() {
        if (abrirMenuIcon) {
            abrirMenuIcon.remove();
        }
    }

    trocaBotao();

    finalizarBalanco.addEventListener('click', async () => {
        pinModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    });

    confirmarPin.addEventListener('click', async () => {
        if (pinInput.value !== userPin) {
            alert('PIN incorreto');
            return;
        }

        pinModal.classList.add('hidden');
        document.body.style.overflow = '';

        const response = await fetch('/balanco/processar', {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                unidade_id
            })
        });

        const data = await response.json();

        if(data.success) {
            containerBalanco.remove();
            sucessoToast.classList.remove('hidden');
            setTimeout(() => {
                window.location.href = '/';
            }, 1500);
        } else {
            falhaToast.classList.remove('hidden');
            setTimeout(() => {
                falhaToast.classList.add('hidden');
            }, 2000);
        }
    });
</script>