<% 
if(typeof(rotate) !== 'undefined') 
{ 
    rotacao = 'group-hover:rotate-180'
} 
else 
{ 
    rotacao = ' ' 
} 
%>


<a href="<%= link %>" class="group w-full md:w-auto items-center shadow-lg hover:shadow-none flex flex-row justify-center text-green-800 text-sm gap-1 bg-white rounded-full px-4 py-2 md:py-1 border border-gray-200 transition duration-300">
    <img class="h-5 <%= rotacao %> transition duration-600" src="/images/icones/<%= icon %>.png" />
    <%= label %>
</a>